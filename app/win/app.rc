// Windows resources of the mfbe shell: application icon, embedded manifest and version info.
// Compiled into mfbe.exe (plain executable) or mfbe.dll (sandboxed bootstrap build).

#include <windows.h>

#include "resource.h"

#if !defined(MFBE_VERSION_RC)
#define MFBE_VERSION_RC 0,0,0,0
#endif
#if !defined(MFBE_VERSION)
#define MFBE_VERSION "0.0.0"
#endif
#if !defined(MFBE_PRODUCT_NAME)
#define MFBE_PRODUCT_NAME "Maxima Fiction Book Editor"
#endif

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
#pragma code_page(65001)

// Icon with lowest ID value placed first to ensure the application icon remains consistent.
IDI_MFBE        ICON    "mfbe.ico"
IDI_MFBE_SMALL  ICON    "mfbe.ico"

// Application manifest (per-monitor-v2 DPI awareness, UTF-8 code page, common controls 6).
// CEF links executables with /MANIFEST:NO, so this resource is the only manifest.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MFBE_VERSION_RC
 PRODUCTVERSION MFBE_VERSION_RC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Quark Zimmerman"
            VALUE "FileDescription",  MFBE_PRODUCT_NAME
            VALUE "FileVersion",      MFBE_VERSION
            VALUE "InternalName",     "mfbe"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Quark Zimmerman. GNU General Public License version 3 (GPL-3.0-only)."
            VALUE "OriginalFilename", "mfbe.exe"
            VALUE "ProductName",      MFBE_PRODUCT_NAME
            VALUE "ProductVersion",   MFBE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

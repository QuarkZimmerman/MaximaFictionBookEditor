# Install tree of the product (T141). Included by the root CMakeLists.txt before the
# sub-directories so that core/, app/, resources/ and ui/ install into one layout; the
# package generators (cmake/MfbePackaging.cmake, packaging/CPackConfig.cmake) consume it.
#
# Linux (FHS; prefix /usr in packages, any --prefix for developers)
#   bin/mfbe                      -> symlink to ../lib/mfbe/mfbe (the desktop launcher's Exec)
#   bin/mfbe-core                 headless core
#   lib/mfbe/mfbe                 CEF shell executable (RPATH $ORIGIN)
#   lib/mfbe/libcef.so, libEGL.so, libGLESv2.so, libvk_swiftshader.so, libvulkan.so.1,
#            v8_context_snapshot.bin, vk_swiftshader_icd.json, chrome-sandbox (4755 root
#            after postinst), *.pak, icudtl.dat, locales/
#   share/mfbe/resources/         schema, genres, dictionaries, symbols, icons, messages
#   share/mfbe/ui/                built UI bundle
#   share/mfbe/scripts/           bundled user scripts
#   share/applications/mfbe.desktop, share/mime/packages/mfbe.xml,
#   share/icons/hicolor/<size>x<size>/apps/mfbe.png, share/doc/mfbe/{LICENSE,...}
#   The executable lives in lib/mfbe because Chromium resolves its own resources, the V8
#   snapshot and the SUID helper relative to the module/executable directory; /proc/self/exe
#   resolves the bin/ symlink, so the core still finds ../share/mfbe/{resources,ui,scripts}.
#
# Windows (flat; MSI root "C:\Program Files\Maxima Fiction Book Editor")
#   bin/mfbe.exe + libcef.dll, chrome_elf.dll, ... + *.pak, icudtl.dat, locales/ (CEF needs
#            everything next to the executable), bin/mfbe-core.exe
#   share/mfbe/{resources,ui,scripts}, share/doc/mfbe/
#
# macOS (bundle; the .dmg contains mfbe.app)
#   mfbe.app/Contents/MacOS/mfbe, Contents/Frameworks/Chromium Embedded Framework.framework,
#   Contents/Frameworks/mfbe Helper*.app, Contents/Resources/{resources,ui,scripts}, icon.
#   bin/mfbe-core is installed beside it for developers (excluded from the .dmg).
#
# Variables for the sub-directories:
#   MFBE_INSTALL_BINDIR      "bin"
#   MFBE_INSTALL_LIBDIR      Linux "lib/mfbe", Windows "bin", macOS "" (bundle)
#   MFBE_INSTALL_DATADIR     Linux/Windows "share/mfbe", macOS "mfbe.app/Contents/Resources"
#   MFBE_INSTALL_DOCDIR      Linux/Windows "share/doc/mfbe", macOS "mfbe.app/Contents/Resources"
#   MFBE_APP_BUNDLE_NAME     "mfbe.app" (macOS)
# Components: core, app, resources, ui, scripts.

include_guard(GLOBAL)

set(MFBE_INSTALL_BINDIR "bin")
set(MFBE_APP_BUNDLE_NAME "mfbe.app")
if(APPLE)
  set(MFBE_INSTALL_LIBDIR "")
  set(MFBE_INSTALL_DATADIR "${MFBE_APP_BUNDLE_NAME}/Contents/Resources")
  set(MFBE_INSTALL_DOCDIR "${MFBE_APP_BUNDLE_NAME}/Contents/Resources")
elseif(WIN32)
  set(MFBE_INSTALL_LIBDIR "bin")
  set(MFBE_INSTALL_DATADIR "share/mfbe")
  set(MFBE_INSTALL_DOCDIR "share/doc/mfbe")
else()
  set(MFBE_INSTALL_LIBDIR "lib/mfbe")
  set(MFBE_INSTALL_DATADIR "share/mfbe")
  set(MFBE_INSTALL_DOCDIR "share/doc/mfbe")
endif()

# CEF locale packs to ship ("" = all ~50 of them, +47 MB). The editor's own interface is
# English/Russian; Chromium falls back to en-US for any other system locale.
set(MFBE_CEF_LOCALES "en-US;ru" CACHE STRING
  "CEF locale .pak files to install (semicolon list; empty = all)")

# Strip the CEF shared libraries when installing (the Linux minimal distribution ships
# libcef.so with debug info: 1.4 GB unstripped, ~260 MB stripped).
option(MFBE_STRIP_CEF_BINARIES "Install stripped copies of the CEF shared libraries" ON)

# Bundled user scripts (read-only bundled layer of the scripts lookup, FR-141).
if(IS_DIRECTORY "${MFBE_SCRIPTS_SOURCE_DIR}")
  install(DIRECTORY "${MFBE_SCRIPTS_SOURCE_DIR}/"
    DESTINATION "${MFBE_INSTALL_DATADIR}/scripts"
    COMPONENT scripts
    PATTERN "CMakeLists.txt" EXCLUDE
    PATTERN ".gitkeep" EXCLUDE)
endif()

# A UI bundle built outside CMake (`cd ui && npm run build`) is installed when MFBE_BUILD_UI is
# OFF; with MFBE_BUILD_UI=ON ui/CMakeLists.txt builds and installs it.
if(NOT MFBE_BUILD_UI AND EXISTS "${MFBE_UI_SOURCE_DIR}/dist/index.html")
  install(DIRECTORY "${MFBE_UI_SOURCE_DIR}/dist/"
    DESTINATION "${MFBE_INSTALL_DATADIR}/ui"
    COMPONENT ui)
endif()

# Licence texts: the GNU GPL version 3 (LICENSE) with the Russian and Ukrainian translations
# and the contributor notice of the original FictionBook Editor, as the original installed
# them. THIRD-PARTY-NOTICES.md is generated by tools/licence-check.py (T156) and is installed
# when present; application builds add the third-party licence texts (licenses/, below).
install(FILES
  "${CMAKE_SOURCE_DIR}/LICENSE"
  "${CMAKE_SOURCE_DIR}/CONTRIBUTORS.txt"
  "${CMAKE_SOURCE_DIR}/gpl-3.0.ru.txt"
  "${CMAKE_SOURCE_DIR}/gpl-3.0.ua.txt"
  DESTINATION "${MFBE_INSTALL_DOCDIR}" COMPONENT app)
if(EXISTS "${CMAKE_SOURCE_DIR}/THIRD-PARTY-NOTICES.md")
  install(FILES "${CMAKE_SOURCE_DIR}/THIRD-PARTY-NOTICES.md"
    DESTINATION "${MFBE_INSTALL_DOCDIR}" COMPONENT app)
endif()

# The AppArmor profile for Ubuntu 24.04+ (packaging/deb-rpm/apparmor/mfbe) is not an install
# rule: a plain `cmake --install --prefix <dir>` must never write outside the prefix. The DEB
# and RPM generators add it to their staging tree as /etc/apparmor.d/mfbe
# (packaging/deb-rpm/CPackPreBuild.cmake).

# ---------------------------------------------------------------------------------------------
# Helpers used by app/CMakeLists.txt.

# mfbe_install_cef_files(<component> <binary_dir> <binary_files> <resource_dir> <resource_files>)
# Installs the CEF binary and resource files into MFBE_INSTALL_LIBDIR (Linux: lib/mfbe,
# Windows: bin). Shared libraries are stripped first when MFBE_STRIP_CEF_BINARIES is ON;
# the locales directory is filtered by MFBE_CEF_LOCALES.
function(mfbe_install_cef_files component binary_dir binary_files resource_dir resource_files)
  set(stripped_dir "${CMAKE_BINARY_DIR}/app/cef-stripped")
  set(stripped_outputs)
  foreach(file IN LISTS binary_files)
    set(source "${binary_dir}/${file}")
    if(IS_DIRECTORY "${source}")
      install(DIRECTORY "${source}" DESTINATION "${MFBE_INSTALL_LIBDIR}" COMPONENT ${component})
    elseif(file STREQUAL "chrome-sandbox")
      # Mode 755 here; packages make it root-owned 4755 in their post-install step.
      install(PROGRAMS "${source}" DESTINATION "${MFBE_INSTALL_LIBDIR}" COMPONENT ${component})
    elseif(file MATCHES "\\.so(\\.[0-9]+)*$" AND MFBE_STRIP_CEF_BINARIES AND CMAKE_STRIP)
      set(output "${stripped_dir}/${file}")
      add_custom_command(OUTPUT "${output}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${stripped_dir}"
        COMMAND "${CMAKE_STRIP}" --strip-unneeded -o "${output}" "${source}"
        DEPENDS "${source}"
        COMMENT "Stripping ${file} for installation"
        VERBATIM)
      list(APPEND stripped_outputs "${output}")
      install(PROGRAMS "${output}" DESTINATION "${MFBE_INSTALL_LIBDIR}" COMPONENT ${component})
    elseif(file MATCHES "\\.(so|dll|exe)$" OR file MATCHES "\\.so\\.[0-9]+$")
      install(PROGRAMS "${source}" DESTINATION "${MFBE_INSTALL_LIBDIR}" COMPONENT ${component})
    else()
      install(FILES "${source}" DESTINATION "${MFBE_INSTALL_LIBDIR}" COMPONENT ${component})
    endif()
  endforeach()
  if(stripped_outputs)
    add_custom_target(mfbe_cef_stripped ALL DEPENDS ${stripped_outputs})
  endif()

  foreach(file IN LISTS resource_files)
    set(source "${resource_dir}/${file}")
    if(file STREQUAL "locales" AND MFBE_CEF_LOCALES)
      set(patterns)
      foreach(locale IN LISTS MFBE_CEF_LOCALES)
        list(APPEND patterns PATTERN "${locale}.pak")
      endforeach()
      install(DIRECTORY "${source}" DESTINATION "${MFBE_INSTALL_LIBDIR}" COMPONENT ${component}
        FILES_MATCHING ${patterns})
    elseif(IS_DIRECTORY "${source}")
      install(DIRECTORY "${source}" DESTINATION "${MFBE_INSTALL_LIBDIR}" COMPONENT ${component})
    else()
      install(FILES "${source}" DESTINATION "${MFBE_INSTALL_LIBDIR}" COMPONENT ${component})
    endif()
  endforeach()
endfunction()

# mfbe_install_bin_symlink(<link_name> <target_relative_path> <component>)
# Installs bin/<link_name> -> <target_relative_path> (POSIX only). The symlink is created in
# the build tree and installed as a symlink.
function(mfbe_install_bin_symlink link_name target component)
  if(WIN32)
    return()
  endif()
  set(link_dir "${CMAKE_BINARY_DIR}/app/install-links")
  file(MAKE_DIRECTORY "${link_dir}")
  file(CREATE_LINK "${target}" "${link_dir}/${link_name}" SYMBOLIC)
  install(FILES "${link_dir}/${link_name}" DESTINATION "${MFBE_INSTALL_BINDIR}"
    COMPONENT ${component})
endfunction()

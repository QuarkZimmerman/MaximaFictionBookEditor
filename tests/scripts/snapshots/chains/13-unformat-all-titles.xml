	<body>
		<section>
			<p><strong>Книга</strong> заголовков</p>
			<p>Эпиграф книги.</p>
		</section>
		<section id="part1">
			<section>
				<p>Часть <emphasis>первая</emphasis></p>
			</section>
			<section>
				<p>Глава первая</p>
				<p>Вторая строка заголовка</p>
				<p>Эпиграф главы.</p>
				<p>Аннотация главы.</p>
				<p>Текст первой главы.</p>
				<p>Стих с заголовком</p>
				<p>Строка один</p>
				<p>Строка два</p>
				<empty-line/>
				<p>Строка три</p>
				<poem>
					<stanza>
						<v>Строфа с заголовком</v>
						<v>Строка четыре</v>
					</stanza>
				</poem>
				<subtitle>Подзаголовок остаётся</subtitle>
				<p>Конец первой главы.</p>
			</section>
			<section>
				<p>Текст раздела без заголовка.</p>
			</section>
		</section>
		<section>
			<p>Глава вторая</p>
			<p>Текст второй главы.</p>
		</section>

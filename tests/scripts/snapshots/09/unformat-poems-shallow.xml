	<body>
		<title>
			<p>Стихи</p>
		</title>
		<section>
			<title>
				<p>Глава со стихами</p>
			</title>
			<p>Текст перед стихом.</p>
			<poem>
				<title>
					<p>Название стиха</p>
				</title>
				<epigraph>
					<p>Эпиграф стиха.</p>
					<text-author>Автор эпиграфа</text-author>
				</epigraph>
				<stanza>
					<v>Первая строка,</v>
					<v>вторая строка.</v>
				</stanza>
				<stanza>
					<subtitle>* * *</subtitle>
					<v>Третья строка,</v>
					<v>четвёртая строка.</v>
				</stanza>
				<text-author>Поэт</text-author>
				<date>1999</date>
			</poem>
			<p>Текст после стиха.</p>
		</section>
		<section>
			<title>
				<p>Стих сразу после заголовка</p>
			</title>
			<p>Строка.</p>
			<p>Ещё строка.</p>
			<empty-line/>
			<p>Последняя строка.</p>
		</section>
		<section>
			<title>
				<p>Стихи в цитате</p>
			</title>
			<cite>
				<p>Строка в цитате.</p>
				<text-author>Автор цитаты</text-author>
			</cite>
		</section>
		<section>
			<title>
				<p>Стих с заглавием</p>
			</title>
			<p>Абзац.</p>
			<poem>
				<title>
					<p>Заглавие</p>
				</title>
				<stanza>
					<v>Строка с заглавием.</v>
				</stanza>
				<stanza>
					<v>Вторая строфа.</v>
				</stanza>
			</poem>
		</section>
	</body>

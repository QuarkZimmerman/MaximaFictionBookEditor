			<genre>prose_classic</genre>
			<author>
				<first-name>Тест</first-name>
				<last-name>Блоки</last-name>
			</author>
			<book-title>Снять форматирование блочным элементом</book-title>
			<annotation>
				<p>Аннотация книги.</p>
				<cite>
					<p>Цитата в аннотации книги.</p>
					<text-author>Автор цитаты в аннотации</text-author>
				</cite>
			</annotation>
			<lang>ru</lang>
		</title-info>
		<document-info>
			<author>
				<nickname>fixture</nickname>
			</author>
			<program-used>…</program-used>
			<date>…</date>
			<id>…</id>
			<version>1.0</version>
		</document-info>
	</description>
	<body>
		<title>
			<p>Снять форматирование блочным элементом</p>
			<p>Вторая строка заголовка книги</p>
		</title>
		<epigraph>
			<p>Эпиграф книги.</p>
			<text-author>Автор эпиграфа книги</text-author>
		</epigraph>
		<section>
			<title>
				<p>Глава 1</p>
				<p>Название первой главы</p>
			</title>
			<epigraph>
				<p>Первый эпиграф.</p>
				<text-author>Автор первого эпиграфа</text-author>
			</epigraph>
			<epigraph>
				<p>Второй эпиграф.</p>
			</epigraph>
			<annotation>
				<p>Аннотация первой главы.</p>
				<subtitle>Подзаголовок аннотации первой главы</subtitle>
			</annotation>
			<p>Текст первой главы.</p>
		</section>
		<section>
			<title>
				<p>Глава 2</p>
			</title>
			<epigraph>
				<p>Эпиграф второй главы.</p>
			</epigraph>
			<image l:href="#pic.png"/>
			<annotation>
				<p>Аннотация второй главы.</p>
			</annotation>
			<p>Текст второй главы.</p>
		</section>
		<section>
			<title>
				<p>Часть первая</p>
			</title>
			<epigraph>
				<p>Эпиграф части.</p>
				<text-author>Автор эпиграфа части</text-author>
			</epigraph>
			<annotation>
				<p>Аннотация части.</p>
			</annotation>
			<section>
				<p>Текст первого подраздела без заголовка.</p>
			</section>
			<section>
				<title>
					<p>Подраздел 2</p>
				</title>
				<p>Текст второго подраздела.</p>
			</section>
		</section>
		<section>
			<title>
				<p>Часть вторая</p>
			</title>
			<section>
				<title>
					<p>Подраздел 3</p>
				</title>
				<p>Текст третьего подраздела.</p>
			</section>
		</section>
		<section>
			<title>
				<p>Глава 3</p>
			</title>
			<poem>
				<title>
					<p>Название стиха</p>
				</title>
				<epigraph>
					<p>Эпиграф стиха.</p>
					<text-author>Автор эпиграфа стиха</text-author>
				</epigraph>
				<stanza>
					<title>
						<p>Заголовок строфы</p>
					</title>
					<v>Первая строка</v>
					<v>Вторая строка</v>
				</stanza>
				<stanza>
					<v>Третья строка</v>
				</stanza>
				<subtitle>Подзаголовок стиха</subtitle>
				<stanza>
					<v>Четвёртая строка</v>
				</stanza>
				<text-author>Поэт</text-author>
				<date>1837</date>
			</poem>
			<p>Абзац между стихом и цитатой.</p>
			<cite>
				<p>Текст цитаты.</p>
				<subtitle>Подзаголовок цитаты</subtitle>
				<poem>
					<stanza>
						<v>Стих в цитате, строка 1</v>
					</stanza>
					<stanza>
						<v>Стих в цитате, строка 2</v>
					</stanza>
				</poem>
				<table>
					<tr>
						<th>Ячейка в цитате</th>
					</tr>
				</table>
				<text-author>Автор цитаты</text-author>
			</cite>
			<p>Абзац между цитатой и таблицей.</p>
			<table id="t1" style="tbl">
				<tr align="center">
					<th>Заголовок 1</th>
					<th colspan="2">Заголовок 2</th>
				</tr>
				<tr>
					<td id="c1" style="x" align="right" valign="top">Ячейка <strong>с жирным</strong></td>
					<td> </td>
					<td></td>
				</tr>
			</table>
			<p>Абзац после таблицы.</p>
			<poem>
				<stanza>
					<title>
						<p>Заголовок второй строфы</p>
					</title>
					<v>Строка второго стиха</v>
				</stanza>
			</poem>
			<p>Последний абзац главы.</p>
		</section>
		<section>
			<title>
				<p>Глава 4</p>
			</title>
			<annotation>
				<p>Аннотация четвёртой главы.</p>
				<subtitle>Подзаголовок аннотации четвёртой главы</subtitle>
				<poem>
					<stanza>
						<v>Стих аннотации</v>
					</stanza>
				</poem>
			</annotation>
			<p>Текст четвёртой главы.</p>
		</section>
	</body>

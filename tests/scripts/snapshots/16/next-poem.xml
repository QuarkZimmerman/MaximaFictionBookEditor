	<body>
		<title>
			<p>Книга элементов</p>
		</title>
		<epigraph>
			<p>Эпиграф книги.</p>
			<text-author>Автор эпиграфа книги</text-author>
		</epigraph>
		<section>
			<title>
				<p>Глава первая</p>
			</title>
			<epigraph>
				<p>Первый эпиграф главы.</p>
			</epigraph>
			<epigraph>
				<p>Второй эпиграф главы.</p>
			</epigraph>
			<annotation>
				<p>Аннотация первой главы.</p>
			</annotation>
			<p>Текст первой главы.</p>
			<cite>
				<p>Первая цитата.</p>
				<text-author>Автор первой цитаты</text-author>
			</cite>
			<empty-line/>
			<cite>
				<p>Вторая цитата.</p>
			</cite>
			<poem>
				<title>
					<p>Первый стих</p>
				</title>
				<epigraph>
					<p>Эпиграф стиха.</p>
				</epigraph>
				<stanza>
					<title>
						<p>Первая строфа</p>
					</title>
					<v>Строка один</v>
					<v>Строка два</v>
				</stanza>
				<stanza>
					<v>Строка три</v>
				</stanza>
				<text-author>Поэт</text-author>
				<date>1900</date>
			</poem>
			<p>Текст между стихами.</p>
			<poem>
				<stanza>
					<v>Строка четыре</v>
				</stanza>
			</poem>
			<poem>
				<title>
					<p>Третий стих</p>
				</title>
				<stanza>
					<v>Строка пять</v>
				</stanza>
			</poem>
			<subtitle>Подзаголовок</subtitle>
			<subtitle>Второй подзаголовок</subtitle>
			<table>
				<tr>
					<th>Шапка таблицы</th>
				</tr>
				<tr>
					<td>Ячейка таблицы</td>
				</tr>
			</table>
			<p>Конец первой главы.</p>
		</section>
		<section>
			<title>
				<p>Глава вторая</p>
			</title>
			<annotation>
				<p>Аннотация второй главы.</p>
			</annotation>
			<section>
				<title>
					<p>Глава вторая, часть первая</p>
				</title>
				<cite>
					<p>Внешняя цитата.</p>
					<poem>
						<epigraph>
							<cite>
								<p>Вложенная цитата.</p>
							</cite>
						</epigraph>
						<stanza>
							<v>Строка шесть</v>
						</stanza>
					</poem>
					<p>Конец внешней цитаты.</p>
				</cite>
				<p>Текст второй главы.</p>
			</section>
		</section>

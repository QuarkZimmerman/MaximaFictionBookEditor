	<body>
		<title>
			<p>Проверка версии <strong>4.7</strong> <emphasis><image l:href="#pic.png"/></emphasis></p>
		</title>
		<section>
			<title>
				<p>Глава первая</p>
			</title>
			<image l:href="#pic.png"/>
			<empty-line/>
			<p>Текст после картинки раздела.</p>
			<poem>
				<stanza>
					<subtitle>**</subtitle>
					<v>Строка стиха</v>
					<v>* * *</v>
					<v>Последняя строка</v>
				</stanza>
			</poem>
			<p>Текст после стиха.</p>
		</section>
		<section>
			<title>
				<p>* * *</p>
				<p><strong>Вторая</strong> <emphasis>строка</emphasis> заголовка</p>
			</title>
			<p>Текст второго раздела.</p>
		</section>
		<section>
			<subtitle>Подзаголовок в начале раздела</subtitle>
			<p>Текст третьего раздела.</p>
		</section>
		<section>
			<title>
				<p>***</p>
			</title>
			<epigraph>
				<p>Эпиграф раздела.</p>
			</epigraph>
			<p>Текст четвёртого раздела.</p>
		</section>
		<section>
			<title>
				<p>* *</p>
			</title>
			<section>
				<title>
					<p>*</p>
				</title>
				<p>Первый подраздел.</p>
			</section>
			<section>
				<title>
					<p>* * *</p>
				</title>
				<image l:href="#pic.png"/>
				<empty-line/>
				<empty-line/>
				<p>Второй подраздел с картинкой.</p>
			</section>
		</section>
	</body>

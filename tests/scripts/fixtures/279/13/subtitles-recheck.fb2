				<last-name>Подзаголовки</last-name>
			</author>
			<book-title>Подзаголовки и пустые строки, версия 4.7</book-title>
			<lang>ru</lang>
		</title-info>
		<document-info>
			<author>
				<nickname>fixture</nickname>
			</author>
			<program-used>fixture</program-used>

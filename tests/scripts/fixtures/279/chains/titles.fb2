	<body>
		<title>
			<p><strong>Книга</strong> заголовков</p>
		</title>
		<epigraph>
			<p>Эпиграф книги.</p>
		</epigraph>
		<section id="part1">
			<title>
				<p>Часть <emphasis>первая</emphasis></p>
			</title>
			<section>
				<title>
					<p>Глава первая</p>
					<p>Вторая строка заголовка</p>
				</title>
				<epigraph>
					<p>Эпиграф главы.</p>
				</epigraph>
				<annotation>
					<p>Аннотация главы.</p>
				</annotation>
				<p>Текст первой главы.</p>
				<poem>
					<title>
						<p>Стих с заголовком</p>
					</title>
					<stanza>
						<v>Строка один</v>
						<v>Строка два</v>
					</stanza>
					<stanza>
						<v>Строка три</v>
					</stanza>
				</poem>
				<poem>
					<stanza>
						<title>
							<p>Строфа с заголовком</p>
						</title>
						<v>Строка четыре</v>
					</stanza>
				</poem>
				<subtitle>Подзаголовок остаётся</subtitle>
				<p>Конец первой главы.</p>
			</section>
			<section>
				<p>Текст раздела без заголовка.</p>
			</section>
		</section>
		<section>
			<title>
				<p>Глава вторая</p>
			</title>
			<p>Текст второй главы.</p>
		</section>
	</body>

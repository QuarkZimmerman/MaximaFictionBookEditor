	<body>
		<title>
			<p>Книга <strong>эпиграфов</strong></p>
		</title>
		<epigraph>
			<p><emphasis>Эпиграф книги</emphasis></p>
			<text-author><strong>Автор</strong> эпиграфа книги</text-author>
		</epigraph>
		<section>
			<title>
				<p>Глава <emphasis>первая</emphasis></p>
			</title>
			<epigraph>
				<p><strong>Первый</strong> эпиграф главы</p>
			</epigraph>
			<epigraph>
				<p><strong><emphasis>Второй</emphasis></strong> эпиграф главы</p>
				<poem>
					<stanza>
						<v><emphasis>Стих</emphasis> в эпиграфе</v>
					</stanza>
				</poem>
				<cite>
					<p><strong>Цитата</strong> в эпиграфе</p>
				</cite>
				<empty-line/>
				<text-author><emphasis>Автор</emphasis> второго эпиграфа</text-author>
			</epigraph>
			<annotation>
				<p>Аннотация <strong>главы</strong>.</p>
			</annotation>
			<p>Абзац с <strong>жирным</strong> и <emphasis>курсивом</emphasis>.</p>
			<poem>
				<epigraph>
					<p><emphasis>Эпиграф</emphasis> стиха</p>
				</epigraph>
				<stanza>
					<v><strong>Строка</strong> стиха</v>
				</stanza>
			</poem>
			<p>Последний абзац <strong>главы</strong>.</p>
		</section>

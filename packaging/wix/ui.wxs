<?xml version="1.0" encoding="UTF-8"?>
<!--
  WixUI dialog set of the Maxima Fiction Book Editor MSI (feature 003, User Story 7; FR-060 to
  FR-062, research R8, contracts/installer.md).

  WixUI_MfbeInstallDir is the project's own copy of the flow of the stock WixUI_InstallDir set,
  written by hand from the documented sequence (the stock sources are not copied):

    first install:   WelcomeDlg -> LicenseAgreementDlg -> MfbeInstallDirDlg -> VerifyReadyDlg
    maintenance:     MaintenanceWelcomeDlg -> MaintenanceTypeDlg -> VerifyReadyDlg
    patch:           WelcomeDlg -> VerifyReadyDlg

  The only difference is the install-folder page: MfbeInstallDirDlg has the controls of the
  stock InstallDirDlg (title, description, banner, folder label, folder edit, Change button,
  Back/Next/Cancel) plus the checkbox "Create a shortcut on the desktop", bound to the public
  property INSTALLDESKTOPSHORTCUT (CheckBoxValue 1). The property itself, its default, its memory
  across upgrades and the components it drives live in shell-integration.wxs, so that they are
  part of the package even without this dialog set (unattended installations never run it).

  Every other dialog (WelcomeDlg, LicenseAgreementDlg, BrowseDlg, InvalidDirDlg, VerifyReadyDlg,
  the maintenance, progress and error dialogs) is the stock one from WixToolset.UI.wixext, which
  CPack passes to `wix build` for every dialog set. The texts of MfbeInstallDirDlg are English
  literals rather than the extension's !(loc.*) strings: the package is built for en-US only
  (CPACK_WIX_CULTURES) and the dialog then depends on nothing but the stock dialog and control
  ids.

  How the set is referenced: the template (mfbe.template.in) carries
  `<ui:WixUI Id="$(var.CPACK_WIX_UI_REF)" />` with CPACK_WIX_UI_REF = WixUI_MfbeInstallDir
  (cmake/MfbePackaging.cmake). In WiX v4+ that element references the UI element named
  "<Id>_<platform>" (X86, X64 or A64), because the two custom actions a dialog set needs - the
  licence printing and the install-path validation of WixToolset.UI.wixext - exist once per
  platform (WixUIPrintEula_X64, WixUIValidatePath_X64, ...), and the stock sets are split into
  a per-platform UI with those Publish rows and a platform-independent UI with the rest. This
  file defines the per-platform ids as plain aliases of the one UI WixUI_MfbeInstallDir, which
  holds the complete set and picks the custom actions of the platform being built from
  $(sys.BUILDARCH): whichever of the two ids the reference resolves to, the whole set is
  linked (a half-linked set would leave the Next button of the folder page dead, something the
  unattended CI installation can never show).

  The dialog set is pinned, like the rest of the MSI, to the WiX tool version the workflows
  install (7.0.0; see packaging/README.md): the stock dialog ids, control ids and the custom
  action names above are those of WiX v4 and later.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- Platform suffix of the UI extension's custom actions (loud failure for an unknown one). -->
  <?if $(sys.BUILDARCH) ~= "x64" ?>
    <?define MfbeUiArch = "X64" ?>
  <?elseif $(sys.BUILDARCH) ~= "x86" ?>
    <?define MfbeUiArch = "X86" ?>
  <?elseif $(sys.BUILDARCH) ~= "arm64" ?>
    <?define MfbeUiArch = "A64" ?>
  <?else ?>
    <?error ui.wxs: no WixUI custom actions known for the platform "$(sys.BUILDARCH)" ?>
  <?endif ?>

  <?foreach WIXUIARCH in X86;X64;A64 ?>
  <Fragment>
    <UI Id="WixUI_MfbeInstallDir_$(var.WIXUIARCH)" />
    <UIRef Id="WixUI_MfbeInstallDir" />
  </Fragment>
  <?endforeach?>

  <Fragment>
    <UI Id="WixUI_MfbeInstallDir">
      <!-- The fonts every stock dialog refers to ({\WixUI_Font_Title} and so on); each dialog
           set defines them, WixUI_Common does not. Tahoma 8/12/9 are the stock English values. -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <!-- Stock dialogs that nothing in this set navigates to by name (they are shown by the
           installer itself or by the ErrorDialog property) and must still be linked in. -->
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- The install-folder page: the stock InstallDirDlg plus the desktop-shortcut checkbox.
           WIXUI_INSTALLDIR names the directory property the folder control edits (INSTALL_ROOT,
           set in mfbe.template.in); the control order is the tab order, the first control gets
           the focus. -->
      <Dialog Id="MfbeInstallDirDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Click Next to install to the default folder or click Change to choose another." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Destination Folder" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="290" Height="30" NoPrefix="yes" Text="Install [ProductName] to:" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="100" Width="320" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="120" Width="56" Height="17" Text="&amp;Change..." />

        <!-- Ticked when INSTALLDESKTOPSHORTCUT is "1" (its default, or the choice recorded by
             the installed version; see shell-integration.wxs). Unticking clears the property,
             which the execute sequence turns into "0". -->
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="160" Width="290" Height="17" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a shortcut on the &amp;desktop" />
      </Dialog>

      <!-- Navigation: the stock InstallDir sequence with MfbeInstallDirDlg in place of
           InstallDirDlg. The licence printing and the path validation (WIXUI_INSTALLDIR_VALID)
           are the UI extension's custom actions of the platform being built. -->
      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_$(var.MfbeUiArch)" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_$(var.MfbeUiArch)" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="MfbeInstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="MfbeInstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="MfbeInstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="MfbeInstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_$(var.MfbeUiArch)" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="MfbeInstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="MfbeInstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="MfbeInstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="MfbeInstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MfbeInstallDirDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- No "Change" in Apps & features: the set has no feature selection (as the stock
           InstallDir set, which defines this property too - do not add it to
           CPACK_WIX_PROPERTY_*). -->
      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>

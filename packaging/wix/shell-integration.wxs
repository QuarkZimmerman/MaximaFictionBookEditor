<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows shell integration of the Maxima Fiction Book Editor MSI (T142, FR-121):

    * ProgIds MaximaFBE.fb2 / MaximaFBE.fbd with the editor's icon and "Open" / "Edit" verbs,
    * the .fb2 / .fbd extensions bound to those ProgIds (plus OpenWithProgids so the editor is
      offered in "Open with" even when another program owns the extension),
    * Default Programs registration (Capabilities + RegisteredApplications) so the editor can
      be chosen in Settings > Default apps.

  Root="HKMU" resolves to HKLM for this per-machine package (see mfbe.template.in), so the
  associations apply to every user of the machine. Every value belongs to a component of the root
  feature (feature.patch.xml), so Windows Installer removes all of them on uninstall and
  MajorUpgrade keeps them across upgrades. Plain registry values are used instead of
  advertised ProgId/Extension elements to avoid MSI self-repair on double-click. Explorer's
  icon cache is refreshed by the application itself (SHChangeNotify on its first start after
  an installation, see app/src/native_actions.cpp).

  Compiled by CPack through CPACK_WIX_EXTRA_SOURCES; INSTALL_ROOT is the directory id CPack
  generates for the installation folder (…\Maxima Fiction Book Editor\), the executable is
  bin\mfbe.exe (cmake/InstallLayout.cmake).

  The second fragment is the optional desktop shortcut (feature 003, User Story 7; FR-060 to
  FR-062, contracts/installer.md): the public property INSTALLDESKTOPSHORTCUT, its memory in the
  registry and the two components it drives (MfbeDesktopShortcutChoice, MfbeDesktopShortcut),
  attached to the root feature by feature.patch.xml as the group MfbeDesktopShortcutGroup. The
  checkbox that edits the property in the interactive installer is in ui.wxs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="MfbeShellIntegration" Directory="INSTALL_ROOT">

      <!-- ProgId for .fb2 -->
      <Component Id="MfbeProgIdFb2" Guid="45AF2997-26FA-4CEF-A91D-45E9CFB5647B">
        <RegistryKey Root="HKMU" Key="Software\Classes\MaximaFBE.fb2">
          <RegistryValue Type="string" Value="FictionBook 2 e-book" KeyPath="yes"/>
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="FictionBook 2 e-book"/>
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[INSTALL_ROOT]bin\mfbe.exe&quot;,0"/>
          </RegistryKey>
          <RegistryKey Key="shell">
            <RegistryValue Type="string" Value="open"/>
            <RegistryKey Key="open">
              <RegistryValue Type="string" Value="Open"/>
              <RegistryKey Key="command">
                <RegistryValue Type="string" Value="&quot;[INSTALL_ROOT]bin\mfbe.exe&quot; &quot;%1&quot;"/>
              </RegistryKey>
            </RegistryKey>
            <RegistryKey Key="edit">
              <RegistryValue Type="string" Value="Edit"/>
              <RegistryKey Key="command">
                <RegistryValue Type="string" Value="&quot;[INSTALL_ROOT]bin\mfbe.exe&quot; &quot;%1&quot;"/>
              </RegistryKey>
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
      </Component>

      <!-- ProgId for .fbd -->
      <Component Id="MfbeProgIdFbd" Guid="C3E9B8B0-0793-40E1-9679-670E4229C1C2">
        <RegistryKey Root="HKMU" Key="Software\Classes\MaximaFBE.fbd">
          <RegistryValue Type="string" Value="FictionBook 2 description" KeyPath="yes"/>
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="FictionBook 2 description"/>
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[INSTALL_ROOT]bin\mfbe.exe&quot;,0"/>
          </RegistryKey>
          <RegistryKey Key="shell">
            <RegistryValue Type="string" Value="open"/>
            <RegistryKey Key="open">
              <RegistryValue Type="string" Value="Open"/>
              <RegistryKey Key="command">
                <RegistryValue Type="string" Value="&quot;[INSTALL_ROOT]bin\mfbe.exe&quot; &quot;%1&quot;"/>
              </RegistryKey>
            </RegistryKey>
            <RegistryKey Key="edit">
              <RegistryValue Type="string" Value="Edit"/>
              <RegistryKey Key="command">
                <RegistryValue Type="string" Value="&quot;[INSTALL_ROOT]bin\mfbe.exe&quot; &quot;%1&quot;"/>
              </RegistryKey>
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
      </Component>

      <!-- Extensions -->
      <Component Id="MfbeExtensionFb2" Guid="6C16B187-2932-4DF1-84BF-44D9AABB785E">
        <RegistryKey Root="HKMU" Key="Software\Classes\.fb2">
          <RegistryValue Type="string" Value="MaximaFBE.fb2" KeyPath="yes"/>
          <RegistryValue Name="Content Type" Type="string" Value="application/x-fictionbook+xml"/>
          <RegistryValue Name="PerceivedType" Type="string" Value="document"/>
          <RegistryKey Key="OpenWithProgids">
            <RegistryValue Name="MaximaFBE.fb2" Type="string" Value=""/>
          </RegistryKey>
        </RegistryKey>
      </Component>
      <Component Id="MfbeExtensionFbd" Guid="34BA076B-5911-494E-A8E2-2580B86E72AE">
        <RegistryKey Root="HKMU" Key="Software\Classes\.fbd">
          <RegistryValue Type="string" Value="MaximaFBE.fbd" KeyPath="yes"/>
          <RegistryValue Name="Content Type" Type="string" Value="application/x-fictionbook+xml"/>
          <RegistryValue Name="PerceivedType" Type="string" Value="document"/>
          <RegistryKey Key="OpenWithProgids">
            <RegistryValue Name="MaximaFBE.fbd" Type="string" Value=""/>
          </RegistryKey>
        </RegistryKey>
      </Component>

      <!-- Application registration: "Open with" entry and Default Programs capabilities -->
      <Component Id="MfbeApplicationRegistration" Guid="55F3DCC0-F497-40BB-A334-764BD37F11DE">
        <RegistryKey Root="HKMU" Key="Software\Classes\Applications\mfbe.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="Maxima Fiction Book Editor" KeyPath="yes"/>
          <RegistryKey Key="SupportedTypes">
            <RegistryValue Name=".fb2" Type="string" Value=""/>
            <RegistryValue Name=".fbd" Type="string" Value=""/>
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALL_ROOT]bin\mfbe.exe&quot; &quot;%1&quot;"/>
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\Maxima Fiction Book Editor\Capabilities">
          <RegistryValue Name="ApplicationName" Type="string" Value="Maxima Fiction Book Editor"/>
          <RegistryValue Name="ApplicationDescription" Type="string" Value="Editor for FictionBook 2 (.fb2/.fbd) e-books"/>
          <RegistryValue Name="ApplicationIcon" Type="string" Value="&quot;[INSTALL_ROOT]bin\mfbe.exe&quot;,0"/>
          <RegistryKey Key="FileAssociations">
            <RegistryValue Name=".fb2" Type="string" Value="MaximaFBE.fb2"/>
            <RegistryValue Name=".fbd" Type="string" Value="MaximaFBE.fbd"/>
          </RegistryKey>
          <RegistryKey Key="MimeAssociations">
            <RegistryValue Name="application/x-fictionbook+xml" Type="string" Value="MaximaFBE.fb2"/>
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKMU" Key="Software\RegisteredApplications">
          <RegistryValue Name="Maxima Fiction Book Editor" Type="string" Value="Software\Maxima Fiction Book Editor\Capabilities"/>
        </RegistryKey>
        <!-- App Paths: `mfbe` resolves from Run dialogs and ShellExecute. -->
        <RegistryKey Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\mfbe.exe">
          <RegistryValue Type="string" Value="[INSTALL_ROOT]bin\mfbe.exe"/>
          <RegistryValue Name="Path" Type="string" Value="[INSTALL_ROOT]bin"/>
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ===== Desktop shortcut (feature 003, User Story 7) ===================================

       INSTALLDESKTOPSHORTCUT ("1" = create the shortcut, "0" = do not) is decided in this order:
         1. a value given on the msiexec command line (FR-062);
         2. the checkbox of MfbeInstallDirDlg (ui.wxs) in an interactive installation;
         3. the value the installed version recorded in
            HKLM\Software\Maxima Fiction Book Editor\DesktopShortcut, read by the RegistrySearch
            below at the start of an upgrade (FR-061);
         4. "1" (FR-060: ticked by default).

       Why the property has no Property-table default and the search writes a separate
       property: Windows Installer gives a property set on the command line to AppSearch
       afterwards, and the search would overwrite it, so the search fills
       DESKTOPSHORTCUT_PREVIOUS and the type-51 actions below copy it only when
       INSTALLDESKTOPSHORTCUT is still empty - a command-line value is never empty, so it wins.
       A Property-table default would also defeat the checkbox: an unticked checkbox *clears*
       its property, nothing is handed over to the execute sequence for it, and the execute
       sequence would fall back to the table default and create the shortcut after all. With
       no default, "empty in the execute sequence of a full-UI installation (UILevel 5)" can
       only mean "unticked" and is turned into "0"; in a silent or basic-UI installation (no
       dialogs, UILevel below 5) "empty" means "not given" and the recorded value or "1"
       applies. The interface sequence applies steps 3 and 4 before the dialogs so the checkbox
       is preset. Secure="yes" lets the value chosen in the interface reach the elevated
       execute sequence of this per-machine package. -->
  <Fragment>
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT_PREVIOUS">
      <RegistrySearch Id="MfbeDesktopShortcutPrevious" Root="HKLM" Key="Software\Maxima Fiction Book Editor" Name="DesktopShortcut" Type="raw" />
    </Property>

    <!-- Interface sequence: preset the checkbox (recorded choice, else on). -->
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Action="MfbeDesktopShortcutUiPrevious" Value="[DESKTOPSHORTCUT_PREVIOUS]"
                 Sequence="ui" After="AppSearch"
                 Condition="NOT INSTALLDESKTOPSHORTCUT AND DESKTOPSHORTCUT_PREVIOUS" />
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Action="MfbeDesktopShortcutUiDefault" Value="1"
                 Sequence="ui" After="MfbeDesktopShortcutUiPrevious"
                 Condition="NOT INSTALLDESKTOPSHORTCUT" />

    <!-- Execute sequence: an empty property after the full interface is the unticked checkbox;
         otherwise the recorded choice, else on. All three run before CostFinalize (component
         conditions) and WriteRegistryValues (the recorded value). -->
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Action="MfbeDesktopShortcutUnticked" Value="0"
                 Sequence="execute" After="AppSearch"
                 Condition="NOT INSTALLDESKTOPSHORTCUT AND UILevel = 5" />
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Action="MfbeDesktopShortcutPrevious" Value="[DESKTOPSHORTCUT_PREVIOUS]"
                 Sequence="execute" After="MfbeDesktopShortcutUnticked"
                 Condition="NOT INSTALLDESKTOPSHORTCUT AND DESKTOPSHORTCUT_PREVIOUS" />
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Action="MfbeDesktopShortcutDefault" Value="1"
                 Sequence="execute" After="MfbeDesktopShortcutPrevious"
                 Condition="NOT INSTALLDESKTOPSHORTCUT" />

    <ComponentGroup Id="MfbeDesktopShortcutGroup">
      <!-- The recorded choice: always installed, so "0" is remembered as well as "1"; its
           removal on uninstall and its rewrite by an upgrade follow the component rules. -->
      <Component Id="MfbeDesktopShortcutChoice" Directory="INSTALL_ROOT" Guid="CC69486F-B95D-496A-86C4-B75F2D164379">
        <RegistryValue Root="HKMU" Key="Software\Maxima Fiction Book Editor" Name="DesktopShortcut" Type="string" Value="[INSTALLDESKTOPSHORTCUT]" KeyPath="yes"/>
      </Component>
      <ComponentRef Id="MfbeDesktopShortcut"/>
    </ComponentGroup>

    <!-- The shortcut itself, on the desktop of all users (DesktopFolder of a per-machine
         package = C:\Users\Public\Desktop), installed only when the property is "1" and
         removed with the product. A shortcut cannot be a key path; like the Start menu entry
         CPack generates, the component uses a registry value under HKCU (what the ICE rules
         for components in profile folders, ICE38/ICE43, ask for). The icon is the product icon
         of the template (CPACK_WIX_PRODUCT_ICON), the target the executable the shell
         integration above registers. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="MfbeDesktopShortcut" Guid="23EC487F-4A8B-4C0E-8CF9-02BFB917A72C" Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="MfbeDesktopShortcutLnk" Name="Maxima Fiction Book Editor"
                  Description="Editor for FictionBook 2 (.fb2/.fbd) e-books"
                  Target="[INSTALL_ROOT]bin\mfbe.exe" WorkingDirectory="INSTALL_ROOT"
                  Icon="ProductIcon.ico" IconIndex="0"/>
        <RegistryValue Root="HKCU" Key="Software\Maxima Fiction Book Editor" Name="DesktopShortcutLink" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </StandardDirectory>
  </Fragment>
</Wix>

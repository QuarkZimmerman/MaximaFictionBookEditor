<?xml version="1.0" encoding="UTF-8"?>

<!--
  CPack WiX template of the Maxima Fiction Book Editor MSI, used through CPACK_WIX_TEMPLATE
  with CPACK_WIX_VERSION 4 (WiX .NET tool v4/v5/v7). It is CMake's own WIX.template.in
  (Modules/Internal/CPack) kept explicit so the package scope and upgrade behaviour are under
  the project's control: a per-machine installation into "C:\Program Files\Maxima Fiction
  Book Editor" (administrator prompt, like any ordinary program), file associations and
  Default Programs registration under HKLM for every user of the machine, in-place upgrades.

  Everything CPack generates (directories, files, start-menu shortcut, features, the ARP
  properties) comes in through the three included .wxi files; the file associations and
  Default Programs registration live in shell-integration.wxs (CPACK_WIX_EXTRA_SOURCES) and
  are attached to the root feature by feature.patch.xml (CPACK_WIX_PATCH_FILE).
-->

<?include "cpack_variables.wxi"?>

<!-- The ProductName (Apps & features, the setup dialogs' [ProductName], the downgrade message):
     while the version has a pre-release part, packaging/CPackConfig.cmake passes
     "-d MfbeProductName=MaximaFictionBookEditor <label>" to wix build (feature 006); otherwise
     it is the package name. Package/@Version stays the numeric form (CPACK_PACKAGE_VERSION). -->
<?ifndef MfbeProductName?>
<?define MfbeProductName = "$(var.CPACK_PACKAGE_NAME)"?>
<?endif?>

<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"@CPACK_WIX_CUSTOM_XMLNS_EXPANDED@
    RequiredVersion="4.0"
    >

    <Package
        Name="$(var.MfbeProductName)"
        Version="$(var.CPACK_PACKAGE_VERSION)"
        Manufacturer="$(var.CPACK_PACKAGE_VENDOR)"
        UpgradeCode="$(var.CPACK_WIX_UPGRADE_GUID)"
        ProductCode="$(var.CPACK_WIX_PRODUCT_GUID)"
        Scope="perMachine"
        InstallerVersion="500"
        Language="1033"
        Compressed="yes"
        >

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>

        <!-- In-place upgrade: an older (or equal) version is removed before the new files are
             installed; downgrades are refused with a message. -->
        <MajorUpgrade
            Schedule="afterInstallInitialize"
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>

        <WixVariable Id="WixUILicenseRtf" Value="$(var.CPACK_WIX_LICENSE_RTF)"/>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALL_ROOT"/>

        <?ifdef CPACK_WIX_PRODUCT_ICON?>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
        <Icon Id="ProductIcon.ico" SourceFile="$(var.CPACK_WIX_PRODUCT_ICON)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_BANNER?>
        <WixVariable Id="WixUIBannerBmp" Value="$(var.CPACK_WIX_UI_BANNER)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_DIALOG?>
        <WixVariable Id="WixUIDialogBmp" Value="$(var.CPACK_WIX_UI_DIALOG)"/>
        <?endif?>

        <FeatureRef Id="ProductFeature"/>

        <ui:WixUI Id="$(var.CPACK_WIX_UI_REF)" />
        <UIRef Id="WixUI_ErrorProgressText" />

        <?include "properties.wxi"?>
        <?include "product_fragment.wxi"?>
    </Package>
</Wix>

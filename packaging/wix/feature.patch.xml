<!-- CPACK_WIX_PATCH_FILE: attaches the shell-integration components and the optional desktop
     shortcut with its recorded choice (both in shell-integration.wxs) to the root feature
     generated by CPack, so they install, upgrade and uninstall with the application. -->
<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCTFEATURE">
    <ComponentGroupRef Id="MfbeShellIntegration"/>
    <ComponentGroupRef Id="MfbeDesktopShortcutGroup"/>
  </CPackWiXFragment>
</CPackWiXPatch>
